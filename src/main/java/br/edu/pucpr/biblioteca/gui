    private void addText(JPanel p,String str){JTextArea t=new JTextArea(str);t.setFont(new Font("SansSerif",Font.PLAIN,15));t.setForeground(new Color(196,211,238));t.setBackground(panel);t.setEditable(false);t.setLineWrap(true);p.add(t);}
    private Object demo(){String id=UUID.randomUUID().toString().substring(0,7);String cpf="cpf"+id,est="E"+id,liv="L"+id;s.pessoas().inserirPessoa(new Pessoa(cpf,"Ana","Exemplo","ana@example.org"));s.estudantes().inserirEstudante(new Estudante(est,cpf));s.livros().inserirLivro(new Livro(liv,"Padrões de Projeto GoF"));StringBuilder r=new StringBuilder("\nLivro "+liv+" | Estudante "+est+"\n");r.append(s.emprestimos().solicitarReserva(liv,est)).append("\n");r.append(s.emprestimos().emprestarLivro(liv,est)).append("\n");r.append(s.emprestimos().renovarEmprestimo(liv,est)).append("\n");LocalDate venc=s.emprestimos().consultarEmprestimo(liv,est).vencimento();r.append(s.devolucoes().registrarDevolucaoEm(liv,est,venc.plusDays(5))).append("\n");String dev=s.devolucoes().consultarUltimaDevolucao(liv,est).id();Boleto boleto=s.devolucoes().emitirBoletoMulta(dev);r.append("MULTA: ").append(boleto==null?"sem multa":"R$ "+boleto.valor()+" | "+boleto.politica()+" | boleto "+boleto.id());return r.toString();}
