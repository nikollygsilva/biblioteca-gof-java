    private JButton button(String text){JButton b=new JButton(text);b.setFont(font);b.setHorizontalAlignment(SwingConstants.LEFT);b.setBackground(new Color(40,53,78));b.setForeground(Color.WHITE);b.setFocusPainted(false);b.setBorder(new EmptyBorder(11,15,11,15));b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));return b;}
    private JPanel card(String title){JPanel p=new JPanel();p.setBackground(panel);p.setLayout(new BoxLayout(p,BoxLayout.Y_AXIS));p.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(new Color(47,61,87)),new EmptyBorder(19,20,19,20)));JLabel l=new JLabel(title);l.setForeground(Color.WHITE);l.setFont(new Font("SansSerif",Font.BOLD,18));l.setAlignmentX(LEFT_ALIGNMENT);p.add(l);p.add(Box.createVerticalStrut(15));return p;}
    private JPanel page(){JPanel p=new JPanel(new GridLayout(0,2,16,16));p.setOpaque(false);return p;}
    private void action(JPanel p,String title,String[] fields,java.util.function.Function<String[],Object> task){JButton b=button("＋  "+title);b.setBackground(accent);b.setAlignmentX(LEFT_ALIGNMENT);b.addActionListener(e->{JPanel form=new JPanel(new GridLayout(fields.length,2,8,9));JTextField[] inputs=new JTextField[fields.length];for(int i=0;i<fields.length;i++){form.add(new JLabel(fields[i]));inputs[i]=new JTextField(18);form.add(inputs[i]);}int result=JOptionPane.showConfirmDialog(this,form,title,JOptionPane.OK_CANCEL_OPTION,JOptionPane.PLAIN_MESSAGE);if(result!=JOptionPane.OK_OPTION)return;String[] values=Arrays.stream(inputs).map(JTextField::getText).map(String::strip).toArray(String[]::new);run(title,()->task.apply(values));});p.add(b);p.add(Box.createVerticalStrut(9));}
    private void run(String name,java.util.function.Supplier<Object> task){try{Object result=task.get();String message="✔ "+name+" → "+(result==null?"Concluído":result);log.append(message+"\n");log.setCaretPosition(log.getDocument().getLength());}catch(Exception ex){log.append("✖ "+name+" → "+ex.getMessage()+"\n");JOptionPane.showMessageDialog(this,ex.getMessage(),"Operação recusada",JOptionPane.WARNING_MESSAGE);}}
    private void showPage(int n){content.removeAll();JPanel grid=page();String[] titles={"Visão geral","Cadastros","Circulação","Devoluções e inspeção","Financeiro e multas","Organização do acervo","Os 10 padrões GoF"};subtitle.setText(titles[n]+"  •  interface conectada aos tratadores do projeto");
        if(n==0){JPanel a=card("Demonstração para o professor");JLabel intro=new JLabel("Reserva → Empréstimo → Renovação → Atraso → Multa");intro.setForeground(new Color(181,194,218));a.add(intro);a.add(Box.createVerticalStrut(18));JButton demo=button("▶  EXECUTAR FLUXO COMPLETO");demo.setBackground(accent);demo.setAlignmentX(LEFT_ALIGNMENT);demo.addActionListener(e->run("Fluxo completo",this::demo));a.add(demo);grid.add(a);JPanel b=card("Situação do acervo");action(b,"Listar livros",new String[]{},v->s.livros().listar().stream().map(l->l.id()+" • "+l.titulo()+" • "+l.estado()).toList());action(b,"Consultar livro",new String[]{"ID do livro"},v->s.livros().consultarLivro(v[0]));grid.add(b);}
        if(n==1){JPanel a=card("Cadastros de pessoas");action(a,"Cadastrar pessoa",new String[]{"CPF","Nome","Sobrenome","E-mail"},v->{s.pessoas().inserirPessoa(new Pessoa(v[0],v[1],v[2],v[3]));return "Pessoa cadastrada";});action(a,"Cadastrar estudante",new String[]{"ID do estudante","CPF já cadastrado"},v->{s.estudantes().inserirEstudante(new Estudante(v[0],v[1]));return "Estudante cadastrado";});action(a,"Cadastrar atendente",new String[]{"ID do atendente","CPF já cadastrado"},v->{s.atendentes().inserirAtendente(new Atendente(v[0],v[1]));return "Atendente cadastrado";});grid.add(a);JPanel b=card("Catálogo");action(b,"Cadastrar livro",new String[]{"ID do livro","Título"},v->{s.livros().inserirLivro(new Livro(v[0],v[1]));return "Livro cadastrado";});action(b,"Listar livros",new String[]{},v->s.livros().listar().stream().map(l->l.id()+" | "+l.titulo()+" | "+l.estado()).toList());grid.add(b);}
        if(n==2){JPanel a=card("Empréstimos");action(a,"Reservar livro",new String[]{"ID livro","ID estudante"},v->s.emprestimos().solicitarReserva(v[0],v[1]));action(a,"Efetivar empréstimo",new String[]{"ID livro","ID estudante"},v->s.emprestimos().emprestarLivro(v[0],v[1]));action(a,"Renovar empréstimo",new String[]{"ID livro","ID estudante"},v->s.emprestimos().renovarEmprestimo(v[0],v[1]));grid.add(a);JPanel b=card("Consulta");action(b,"Consultar metadados",new String[]{"ID livro"},v->s.consultas().consultarMetadados(v[0]));grid.add(b);}
        if(n==3){JPanel a=card("Devolução");action(a,"Registrar devolução",new String[]{"ID livro","ID estudante"},v->s.devolucoes().registrarDevolucao(v[0],v[1]));action(a,"Inspecionar livro",new String[]{"ID livro","Bom estado? (s/n)"},v->s.devolucoes().inspecionarLivro(v[0],v[1].equalsIgnoreCase("s")));grid.add(a);JPanel b=card("Reparo e descarte");action(b,"Enviar para reparo",new String[]{"ID livro"},v->s.devolucoes().enviarParaReparo(v[0]));action(b,"Retorno do reparo",new String[]{"ID livro"},v->s.devolucoes().registrarRetornoReparo(v[0]));action(b,"Laudo irrecuperável",new String[]{"ID livro"},v->s.devolucoes().laudoIrrecuperavel(v[0]));grid.add(b);}
        if(n==4){JPanel a=card("Boletos e pagamentos");action(a,"Consultar boleto",new String[]{"ID boleto"},v->{Boleto b=s.financeiro().consultarBoleto(v[0]);return b==null?"Não encontrado":b.id()+" | R$ "+b.valor()+" | "+b.politica()+" | quitado="+b.quitado();});action(a,"Confirmar pagamento",new String[]{"ID boleto","Situação do banco (A=00 / B=LIQUIDADO)"},v->s.financeiro().confirmarPagamento(v[0],v[1]));grid.add(a);JPanel b=card("Políticas de multa (Strategy)");JTextArea t=new JTextArea("ORIGINAL: R$ 1 por dia\nTETO: limite de R$ 20\nTOLERANCIA: 2 dias sem cobrança\n\nConfigure BIBLIOTECA_POLITICA nas variáveis\nde ambiente do IntelliJ antes de executar.\nA regra permanece fora da interface.");t.setEditable(false);t.setBackground(panel);t.setForeground(Color.WHITE);t.setFont(font);b.add(t);grid.add(b);}
        if(n==5){JPanel a=card("Seções do acervo");action(a,"Criar seção",new String[]{"Grupo pai (ex.: Biblioteca)","Nova seção"},v->{s.hierarquia().criarGrupo(v[0],v[1]);return "Seção criada";});action(a,"Associar livro",new String[]{"Seção","ID livro"},v->{s.hierarquia().associarLivro(v[0],v[1]);return "Livro associado";});grid.add(a);JPanel b=card("Organização hierárquica");action(b,"Mover livro",new String[]{"ID livro","Seção origem","Seção destino"},v->{s.hierarquia().moverLivro(v[0],v[1],v[2]);return "Livro movido";});action(b,"Contar e listar seção",new String[]{"Seção (ex.: Biblioteca)"},v->"Total="+s.hierarquia().contar(v[0])+" | IDs="+s.hierarquia().listar(v[0]));grid.add(b);}
        if(n==6){JPanel a=card("Padrões comportamentais");addText(a,"State • Estados do livro\nStrategy • Cálculo de multas\nObserver • Eventos de devolução\nCommand • Solicitações idempotentes\nTemplate Method • Cadastros");grid.add(a);JPanel b=card("Padrões estruturais e criacionais");addText(b,"Adapter • Integração bancária\nFacade • Operações de circulação\nAbstract Factory • Persistência\nDecorator • Consultas e cache\nComposite • Hierarquia do acervo");grid.add(b);}
        JScrollPane scroll=new JScrollPane(grid);scroll.setBorder(null);scroll.getViewport().setBackground(bg);content.add(scroll,BorderLayout.CENTER);content.revalidate();content.repaint();
